API_PORT=8787
APP_ORIGINS=http://localhost:8443

# node server/scripts/hash-password.mjs 명령으로 생성한 scrypt 해시만 입력합니다.
ADMIN_LOGIN_ID=change-me
ADMIN_PASSWORD_HASH=scrypt$32768$8$1$change-me
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# 로컬 미리보기에서만 허용합니다. 운영에서는 반드시 false로 두세요.
ALLOW_LOCAL_DATA=false

# 서버 전용 값입니다. VITE_ 접두사를 붙이거나 브라우저에 노출하면 안 됩니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
